@model IEnumerable<BloodBankApp.Models.Donor>

@{
    ViewData["Title"] = "Donor List";
}

<h1>All Registered Donors</h1>

<!-- Link to create page using plain HTML -->
<p>
    <a href="/Donor/Create" class="btn btn-primary">Add New Donor</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Contact No</th>
            <th>City</th>
            <th>Last Donation Date</th>
            <th>Actions</th> <!-- This is the column header for our links -->
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.BloodGroup</td>
                <td>@item.ContactNo</td>
                <td>@item.City</td>
                <td>@item.LastDonationDate.ToShortDateString()</td>

                <!-- THIS IS WHERE YOU PUT THE CODE -->
                <td>
                    <!-- Plain HTML Edit Link -->
                    <a href="/Donor/Edit/@item.DonorId">Edit</a> |

                    <!-- Plain HTML Delete Link with confirmation -->
                    <a href="/Donor/Delete/@item.DonorId"
                       onclick="return confirm('Are you sure you want to delete this donor?')">
                        Delete
                    </a>
                </td>
                <!-- END OF THE CODE SECTION -->
            </tr>
        }
    </tbody>
</table>